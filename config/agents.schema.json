{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentsConfig",
  "type": "object",
  "required": ["version", "agents"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "global": {
      "type": "object"
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": ["id", "name", "model", "type", "enabled", "role", "callType"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "callType": {
          "enum": ["cli", "http"]
        },
        "config": {
          "type": "object"
        },
        "decision": {
          "type": "object"
        },
        "prompts": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
