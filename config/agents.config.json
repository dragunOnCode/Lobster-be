{
  "$schema": "./agents.schema.json",
  "version": "1.0.0",
  "agents": [
    {
      "id": "claude-001",
      "name": "Claude",
      "model": "anthropic/claude-3-sonnet",
      "type": "claude",
      "enabled": true,
      "role": "architecture_and_implementation",
      "description": "Owns system design, implementation planning, code generation, and technical decisions.",
      "capabilities": [
        "architecture_design",
        "code_generation",
        "refactoring",
        "tech_selection",
        "implementation"
      ],
      "callType": "http",
      "config": {
        "apiProvider": "openrouter",
        "baseURL": "https://openrouter.ai/api/v1",
        "temperature": 0.7,
        "maxTokens": 4000,
        "timeout": 60000
      },
      "decision": {
        "keywords": [
          "architecture",
          "design",
          "implement",
          "implementation",
          "code",
          "refactor",
          "optimize",
          "tech stack",
          "selection"
        ],
        "autoRespond": true,
        "priority": "high",
        "mentionRequired": false
      },
      "prompts": {
        "systemPrompt": "You are Claude. Focus on architecture, implementation, and practical technical decisions. Answer directly and provide executable guidance.",
        "contextTemplate": "Current session: {{sessionId}}\nRecent conversation:\n{{conversationHistory}}\n\nWorkspace state:\n{{workspaceState}}"
      }
    },
    {
      "id": "codex-001",
      "name": "Codex",
      "model": "codex-cli",
      "type": "codex",
      "enabled": true,
      "role": "code_review_and_quality",
      "description": "Owns code review, test suggestions, security checks, and engineering quality control.",
      "capabilities": [
        "code_review",
        "static_analysis",
        "test_suggestions",
        "security_review",
        "performance_analysis",
        "style_checks"
      ],
      "callType": "cli",
      "config": {
        "cliPath": "codex-cli",
        "args": [
          "--format",
          "json",
          "--timeout",
          "60"
        ],
        "timeout": 60000,
        "maxRetries": 3
      },
      "decision": {
        "keywords": [
          "review",
          "check",
          "test",
          "quality",
          "bug",
          "issue",
          "optimize",
          "performance",
          "security"
        ],
        "autoRespond": true,
        "priority": "medium",
        "mentionRequired": false,
        "triggerOnCodeChange": true
      },
      "prompts": {
        "systemPrompt": "You are Codex. Focus on review, correctness, risk detection, testing, and quality feedback. Point to concrete issues and suggested fixes.",
        "contextTemplate": "Current file: {{filePath}}\nCode change:\n{{codeChange}}\n\nRelated context:\n{{relatedCode}}"
      }
    },
    {
      "id": "gemini-001",
      "name": "Gemini",
      "model": "gemini-pro",
      "type": "gemini",
      "enabled": true,
      "role": "creative_and_experience_design",
      "description": "Owns UI and UX suggestions, visual direction, and interaction improvements.",
      "capabilities": [
        "creative_direction",
        "ui_feedback",
        "ux_feedback",
        "visual_review",
        "interaction_design",
        "experience_improvement"
      ],
      "callType": "cli",
      "config": {
        "cliPath": "gemini",
        "args": [
          "--model",
          "gemini-pro",
          "--format",
          "json"
        ],
        "temperature": 0.8,
        "maxTokens": 4000,
        "timeout": 60000
      },
      "decision": {
        "keywords": [
          "design",
          "ui",
          "ux",
          "layout",
          "visual",
          "interaction",
          "experience",
          "creative",
          "style"
        ],
        "autoRespond": true,
        "priority": "medium",
        "mentionRequired": false
      },
      "prompts": {
        "systemPrompt": "You are Gemini. Focus on creative direction, UI and UX quality, and the end-user experience. Prioritize usability and visual clarity.",
        "contextTemplate": "Current view: {{currentView}}\nUser feedback: {{userFeedback}}\n\nDesign goals:\n{{designGoals}}"
      }
    }
  ],
  "global": {
    "decisionEngine": {
      "mode": "parallel",
      "timeout": 5000,
      "maxConcurrent": 3,
      "fallbackAgent": "claude-001"
    },
    "memory": {
      "shortTermSize": 20,
      "longTermEnabled": true,
      "sharedMemoryEnabled": true
    },
    "response": {
      "streamEnabled": true,
      "maxResponseTime": 60000,
      "retryOnFailure": true,
      "maxRetries": 3
    },
    "workspace": {
      "watchFiles": true,
      "autoAnalyze": true,
      "transcriptEnabled": true
    }
  }
}
