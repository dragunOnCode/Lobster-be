NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=lobster
DB_DATABASE=lobster
DB_SYNCHRONIZE=false
DB_LOGGING=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SHORT_TERM_MEMORY_TTL=300
SHORT_TERM_MEMORY_SIZE=20
SHARED_MEMORY_TTL=3600

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://lobster.local
OPENROUTER_APP_TITLE=Lobster Coding Assistant

CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT_MS=60000

CODEX_CLI_PATH=codex-cli
CODEX_TIMEOUT_MS=60000

GEMINI_CLI_PATH=gemini
GEMINI_TIMEOUT_MS=60000

WORKSPACE_ROOT=./workspace/sessions

# Embedding 提供商（ollama | openai）
EMBEDDING_PROVIDER=ollama
EMBEDDING_BATCH_SIZE=50

# Ollama Embedding（默认）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI Embedding（可选）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

