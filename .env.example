# 环境变量配置模板
# 复制此文件为 .env 并填写实际值

#====================
# 应用配置
#====================
NODE_ENV=development
PORT=3000
APP_NAME=Lobster
APP_VERSION=0.1.0

#====================
# 数据库配置
#====================
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=lobster
DB_DATABASE=lobster
DB_SYNCHRONIZE=false
DB_LOGGING=true

#====================
# Redis配置
#====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

#====================
# Agent配置
#====================
# OpenRouter (用于Claude)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://lobster.local
OPENROUTER_APP_TITLE=Lobster Coding Assistant

# Gemini CLI
GEMINI_CLI_PATH=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Codex CLI
CODEX_CLI_PATH=codex-cli

#====================
# 工作空间配置
#====================
WORKSPACE_ROOT=./workspace/sessions
MAX_FILE_SIZE_MB=10
TRANSCRIPT_ENABLED=true

#====================
# 记忆配置
#====================
# 短期记忆
SHORT_TERM_MEMORY_TTL=300
SHORT_TERM_MEMORY_SIZE=20

# 长期记忆
LONG_TERM_MEMORY_ENABLED=true

# 共享记忆
SHARED_MEMORY_TTL=3600

#====================
# 向量数据库（ChromaDB）
#====================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=lobster_memories

#====================
# 对象存储（MinIO）
#====================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lobster-files
MINIO_USE_SSL=false

#====================
# WebSocket配置
#====================
WS_CORS_ORIGIN=*
WS_PATH=/socket.io
WS_MAX_CONNECTIONS=1000

#====================
# 日志配置
#====================
LOG_LEVEL=debug
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs

#====================
# 安全配置
#====================
# JWT（Sprint 4使用）
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:8080

# 速率限制
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

#====================
# 任务队列（BullMQ）
#====================
BULL_QUEUE_PREFIX=lobster
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

#====================
# 定时任务
#====================
CRON_HEALTH_CHECK_ENABLED=true
CRON_HEALTH_CHECK_INTERVAL=*/5 * * * *

CRON_MEMORY_SUMMARY_ENABLED=true
CRON_MEMORY_SUMMARY_INTERVAL=0 * * * *

CRON_SESSION_CLEANUP_ENABLED=true
CRON_SESSION_CLEANUP_INTERVAL=0 2 * * *

#====================
# 监控配置（Sprint 4使用）
#====================
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

#====================
# LangGraph配置
#====================
LANGGRAPH_ENABLED=false
LANGGRAPH_MODE=free

#====================
# 开发配置
#====================
# Config热重载
CONFIG_WATCH_ENABLED=true
CONFIG_RELOAD_DELAY=500

# Debug模式
DEBUG=true
VERBOSE_LOGGING=true

#====================
# Agent特定配置
#====================
# Claude
CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT_MS=60000

# Codex
CODEX_TIMEOUT_MS=60000
CODEX_MAX_RETRIES=3

# Gemini
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_TOKENS=4000
GEMINI_TIMEOUT_MS=60000

#====================
# 性能配置
#====================
# 数据库连接池
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis连接池
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# Agent并发限制
AGENT_MAX_CONCURRENT=3
AGENT_QUEUE_SIZE=100

#====================
# 测试配置
#====================
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USERNAME=test
TEST_DB_PASSWORD=test
TEST_DB_DATABASE=lobster_test
